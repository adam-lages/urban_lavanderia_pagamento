{
  "name": "urban-lavanderia-pagamentos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w @lav/backend run dev",
    "dev:backend": "npm -w @lav/backend run dev",
    "dev:mqtt": "npm -w @lav/backend run mqtt",
    "dev:dashboard": "npm -w @lav/dashboard run dev",
    "dashboard": "npm -w @lav/dashboard run dev",
    "start": "npm -w @lav/dashboard run start",
    "dev:simulator": "npm -w @lav/simulator run start",
    "test": "npm -w @lav/backend run test && npm -w @lav/simulator run test && npm -w @lav/dashboard run test",
    "typecheck": "npm -w @lav/protocol run typecheck && npm -w @lav/backend run typecheck && npm -w @lav/simulator run typecheck && npm -w @lav/dashboard run typecheck",
    "build:dashboard": "npm -w @lav/dashboard run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.12",
    "@types/node": "^22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
