# Versionado de propósito: repositório PRIVADO. Nunca tornar público sem rotacionar.
# Valores padrão atuais do projeto (desenvolvimento). Sem credenciais Stone/LG: não existem ainda.
#
# No computador (npm run dev:backend): banco e MQTT já sobem DENTRO do Node.
#   DATABASE_EMBEDDED=true  → Postgres em memória (pg-mem). Some ao fechar o terminal.
#   MQTT_EMBEDDED=true      → broker Aedes na porta 1883. Dashboard e simulador usam isso.
# Docker / produção / hml: desligue o modo embutido e use Postgres + Mosquitto de verdade.

POSTGRES_USER=lav
POSTGRES_PASSWORD=lav
POSTGRES_DB=lav
DATABASE_URL=postgres://lav:lav@localhost:5432/lav
DATABASE_EMBEDDED=true
MQTT_URL=mqtt://localhost:1883
MQTT_EMBEDDED=true
MQTT_USERNAME=
MQTT_PASSWORD=
ADMIN_TOKEN=dev-admin-token
POS_TOKEN=dev-pos-token
PORT=3000
COMMAND_TTL_SECONDS=60
ACK_TIMEOUT_SECONDS=60
REQUIRE_DEVICE_ONLINE=true
ENABLE_SIMULATED_PAYMENTS=true
DEVICE_IDS=esp-m1,esp-m2,esp-m3,esp-m4
API_URL=http://localhost:3000
